              "type": "string"
            },
            {
              "id": "ea13d7b4-7251-4761-891c-42e3632d63c0",
              "name": "monto",
              "value": "={{ $('Configuración').item.json.Monto }}",
              "type": "number"
            },
            {
              "id": "fbd1a657-a232-430d-8f28-e21209c4894b",
              "name": "centro",
              "value": "={{ $('Configuración').item.json['Centro de costo'] }}",
              "type": "string"
            },
            {
              "id": "6e22f597-d1ae-402d-8662-7c55204a7a42",
              "name": "fechaGasto",
              "value": "={{ $('Configuración').item.json['Fecha del gasto'] }}",
              "type": "string"
            },
            {
              "id": "f36f4207-c72e-459c-826a-07750b8e7494",
              "name": "estado",
              "value": "={{ $json.data.approved ? 'Aprobado' : 'Rechazado' }}",
              "type": "string"
            },
            {
              "id": "9c7d2231-85bc-4be0-8eff-19b782159e47",
              "name": "decidio",
              "value": "={{ $('Configuración').item.json.aprobador }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
