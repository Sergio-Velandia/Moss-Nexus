          "value": "#mi-bandeja",
          "mode": "name"
        },
        "text": "=:inbox_tray: *Tu bandeja: {{ $('Preparar correos').item.json.total }} correos sin leer*\n\n{{ $json.choices[0].message.content }}",
        "otherOptions": {
