      },
      "id": "ed58c041-6662-451f-8751-09718fe9d1dd",
      "name": "Configuración",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "limit": 40,
        "filters": {
          "q": "is:unread newer_than:1d -category:promotions -category:social"
        }
      },
      "id": "989744ec-46aa-4e38-895b-00f74f50c6f9",
      "name": "Correos sin leer",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        440,
        0
      ],
      "alwaysOutputData": true,
      "webhookId": "4661d59b-e764-4399-804b-9a210521bfc8",
      "notes": "Sin leer de las últimas 24 horas, sin promociones ni redes sociales. Máximo 40.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "// Prepara la lista de correos sin leer para la IA (sin cuerpos completos: remitente, asunto y extracto)\nconst correos = $input.all()\n  .map((item) => item.json)\n  .filter((c) => c.id);\n\nconst lista = correos.slice(0, 40).map((c, i) => {\n  const de = c.From || c.from?.text || c.from || 'desconocido';\n  const asunto = c.Subject || c.subject || '(sin asunto)';\n  const extracto = String(c.snippet || c.text || '').replace(/\\s+/g, ' ').slice(0, 300);\n  return (i + 1) + '. De: ' + de + ' | Asunto: ' + asunto + ' | Extracto: ' + extracto;\n}).join('\\n');\n\nreturn [{\n  json: {\n    hayCorreos: correos.length > 0,\n    total: correos.length,\n    lista,\n    modelo: $('Configuración').first().json.modelo,\n  },\n}];"
      },
      "id": "a41ae7b3-3dd5-4123-8ff6-40d9bc328e55",
      "name": "Preparar correos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "0ac43e31-1048-405a-8f8d-12a45e865027",
              "leftValue": "={{ $json.hayCorreos }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "1e980cbd-fd2d-49e0-889a-b2ec25b54cdc",
      "name": "¿Hay correos?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $json.modelo, temperature: 0.2, messages: [ { role: 'system', content: 'Eres un asistente ejecutivo. Recibes la lista de correos sin leer de las últimas 24 horas. Escribe en español un resumen para Slack con tres secciones: *Requiere acción hoy* (máximo 5 viñetas, con remitente y qué hay que hacer), *Para leer después* (agrupado por tema, una línea cada uno) y *Puedes ignorar* (una sola línea). Sé breve y no inventes información que no esté en la lista.' }, { role: 'user', content: $json.lista } ] }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "c1a205c9-6eb9-45d2-8527-6b702e7dbc53",
      "name": "Resumir con IA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
