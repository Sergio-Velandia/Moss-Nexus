      "typeVersion": 4.5,
      "position": [
        220,
        0
      ],
      "alwaysOutputData": true,
      "notes": "«Always Output Data» está activado: si el evento no existe, sigue con un elemento vacío.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "3d7876d7-c683-499e-8faf-be9dbd213b96",
              "leftValue": "={{ $json['ID de evento'] }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "47b95741-dd3c-4641-89eb-29a27ae2f9f4",
      "name": "¿Ya procesado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {},
      "id": "ed65112d-873d-45d6-874a-5bd7709ba950",
      "name": "Ignorar duplicado",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        680,
        -120
      ],
      "notes": "Stripe reintenta los webhooks: si el evento ya se registró, no se repite nada.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b29448d2-cd6e-426d-8fc4-30b11cc3ab1e",
              "name": "evento",
              "value": "={{ $('Pago recibido').item.json.id }}",
              "type": "string"
            },
            {
              "id": "535fe753-0e72-4878-8616-d37849994271",
              "name": "sesion",
              "value": "={{ $('Pago recibido').item.json.data.object.id }}",
              "type": "string"
            },
            {
              "id": "3298e893-55a6-4f99-86b5-3ef306115a50",
              "name": "cliente",
              "value": "={{ $('Pago recibido').item.json.data.object.customer_details?.name ?? 'Sin nombre' }}",
              "type": "string"
            },
            {
              "id": "dab9a13d-80ca-457c-8e8b-55c9d1c6479d",
              "name": "correo",
              "value": "={{ $('Pago recibido').item.json.data.object.customer_details?.email ?? '' }}",
              "type": "string"
            },
            {
              "id": "165d73d3-1498-41de-8b70-5e65feca31bd",
              "name": "monto",
              "value": "={{ ($('Pago recibido').item.json.data.object.amount_total / 100).toFixed(2) }}",
              "type": "string"
            },
            {
              "id": "73319d80-61e3-48fd-8611-4541df96dbd7",
              "name": "moneda",
              "value": "={{ String($('Pago recibido').item.json.data.object.currency ?? '').toUpperCase() }}",
              "type": "string"
            },
            {
              "id": "0679efe1-4abe-4fd1-817f-775106b2fb0c",
              "name": "fecha",
              "value": "={{ DateTime.fromSeconds($('Pago recibido').item.json.created).toFormat('yyyy-MM-dd HH:mm') }}",
              "type": "string"
            },
            {
              "id": "9d4a2e7f-1b6c-4f3a-8e5d-2c7b0a9f4e18",
              "name": "montoTexto",
              "value": "={{ (() => { const o = $('Pago recibido').item.json.data.object; const moneda = String(o.currency ?? 'cop').toUpperCase(); return new Intl.NumberFormat('es-CO', { style: 'currency', currency: moneda, maximumFractionDigits: moneda === 'COP' ? 0 : 2 }).format(o.amount_total / 100); })() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "859f000b-710b-4c79-8057-2947f9101d95",
      "name": "Preparar pedido",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
