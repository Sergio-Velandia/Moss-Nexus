        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "ID de evento",
              "lookupValue": "={{ $json.id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "5db312ae-8ebf-46c9-8f3c-6ec448b8480d",
      "name": "Buscar evento",
